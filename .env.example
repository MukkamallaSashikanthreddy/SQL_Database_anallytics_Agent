# Required for Gemini SQL generation
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite

# SQLite database URL
DATABASE_URL=sqlite:///database/analytics.db

# Input safety
NEMO_GUARDRAILS_CONFIG=config/guardrails
NEMO_LIVE_INFERENCE=false

# Only required when NEMO_LIVE_INFERENCE=true. This may incur separate provider charges.
OPENAI_API_KEY=

# Query limits
MAX_SQL_RETRIES=3
MAX_RESULT_ROWS=1000
